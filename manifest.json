{
  "manifest_version": 3,
  "name": "Image Queue for ChatGPT",
  "version": "0.1.0",
  "description": "Run a queue of image prompts in your active ChatGPT conversation and save the results.",
  "permissions": ["storage", "unlimitedStorage", "downloads", "alarms"],
  "host_permissions": ["https://chatgpt.com/*"],
  "action": {"default_popup": "popup.html"},
  "background": {"service_worker": "background.js"},
  "content_scripts": [{"matches": ["https://chatgpt.com/*"], "js": ["content.js"]}]
}
